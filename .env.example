APP_ENV=development
DATABASE_URL=sqlite:///./data/meetflow.db
DATA_DIR=data
PLUGINS_DIR=plugins
FRONTEND_DIST=frontend-dist

ADMIN_USERNAME=admin
ADMIN_PASSWORD=meetflow-local-admin
APP_SECRET_KEY=local-only-meetflow-secret-key-2026-change-me

ALLOW_REGISTRATION=true
SECURE_COOKIES=false
TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_BYTES=20971520
PLUGIN_TIMEOUT_SECONDS=60

MEETFLOW_PORT=8000
MEETFLOW_BIND=127.0.0.1
