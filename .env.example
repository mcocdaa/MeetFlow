# MeetFlow 服务器配置模板：复制为 .env 后编辑。
#   cp .env.example .env && vim .env
# .env 包含密钥，已在 .gitignore 中；不要提交或公开分享。
#
# 必改项（APP_ENV=production 时启动会校验，未替换将拒绝启动）：
#   ADMIN_PASSWORD    至少 12 位，建议用密码管理器生成
#   APP_SECRET_KEY    用下面命令生成并长期保存，更换会使登录会话失效
#                     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   TRUSTED_ORIGINS   你的 HTTPS 来源，多个用逗号分隔，不带路径
#
# 修改 .env 后重启容器生效：docker restart meetflow

APP_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
APP_SECRET_KEY=change-me
ALLOW_REGISTRATION=false
SECURE_COOKIES=true
TRUSTED_ORIGINS=https://meetflow.example.com

# 可选：单个附件上限（字节），默认 20 MiB
# MAX_UPLOAD_BYTES=20971520
# 可选：插件任务超时（秒），默认 60
# PLUGIN_TIMEOUT_SECONDS=60
